formulas:
  herramienta: file.name.replace(".base", "")
  categoría: |
    if(file.folder.contains("/01 - Recon y escaneo"), "01 · Recon y escaneo",
      if(file.folder.contains("/02 - Evaluación de vulnerabilidades"), "02 · Evaluación de vulnerabilidades",
        if(file.folder.contains("/03 - Web"), "03 · Web",
          if(file.folder.contains("/04 - Red y MITM"), "04 · Red y MITM",
            if(file.folder.contains("/05 - Credenciales"), "05 · Credenciales",
              if(file.folder.contains("/06 - Explotación"), "06 · Explotación",
                if(file.folder.contains("/07 - Wi-Fi"), "07 · Wi-Fi",
                  if(file.folder.contains("/08 - Reversing y binario"), "08 · Reversing y binario",
                    if(file.folder.contains("/09 - SAST"), "09 · SAST",
                      if(file.folder.contains("/10 - Seguridad de IA"), "10 · Seguridad de IA",
                    "· Sin clasificar"))))))))))
properties:
  formula.herramienta:
    displayName: Herramienta
  formula.categoría:
    displayName: Categoría
  file.folder:
    displayName: Ubicación
views:
  - type: cards
    name: Arsenal
    filters:
      and:
        - file.ext == "base"
        - file.folder.startsWith("02 - Recursos/🛠️ Tools")
        - file.name != "Tools.base"
    order:
      - formula.herramienta
    sort:
      - property: file.name
        direction: ASC
    cardSize: 260
  - type: table
    name: Por categoría
    filters:
      and:
        - file.ext == "base"
        - file.folder.startsWith("02 - Recursos/🛠️ Tools")
        - file.name != "Tools.base"
    groupBy:
      property: formula.categoría
      direction: ASC
    order:
      - formula.herramienta
      - file.folder
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      formula.herramienta: 300
      file.folder: 380
  - type: table
    name: Todas las notas
    filters:
      and:
        - file.folder.startsWith("02 - Recursos/🛠️ Tools")
        - file.ext == "md"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 400
      file.tags: 523
      note.Fecha de actualización: 150
